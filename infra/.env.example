# ScamShield Immune: compose environment.  Copy to infra/.env and edit.
#
#   cp infra/.env.example infra/.env
#
# EVERY VALUE BELOW IS A DEMO-ONLY PLACEHOLDER. It is public (it is in the repository), so it must
# never be used anywhere reachable by anyone but you. Replace each one before running; generation
# commands are given per variable. `docker compose` refuses to start while a required value is empty.
#
# Nothing here is a real credential, and the stack only handles simulator-generated data.

# --- Gateway (services/gateway) ---------------------------------------------------------------
# HS256 signing secret for the staff/citizen JWTs. At least 32 bytes (the gateway refuses shorter).
#   openssl rand -hex 32
GATEWAY_JWT_SECRET=demo-only-change-me-0000000000000000000000000000000000000000000000
# Demo accounts (one per role: officer, analyst, citizen, admin; username == role). The gateway has
# no user database, so GATEWAY_DEMO_USERS=1 is how you can log in at all. Demo only.
#   openssl rand -hex 16
GATEWAY_DEMO_PASSWORD=demo-only-change-me-0000000000000000

# --- Antibody hub <-> bank services ---------------------------------------------------------------
# Shared secret the txn-guards present (X-Gateway-Secret) when they call the hub.
#   openssl rand -hex 32
HUB_GATEWAY_SECRET=demo-only-change-me-1111111111111111111111111111111111111111111111

# --- Postgres (hub, ledger and graph-twin databases) ---------------------------------------------
# Use hex only (it is embedded in a URL).   openssl rand -hex 16
POSTGRES_PASSWORD=demo-only-change-me-2222222222222222

# --- Demo server (single-process demo + console, port 8080) --------------------------------------
# JWT secret for the demo server's own /api/auth/demo-login tokens. >= 32 bytes.
#   openssl rand -hex 32
DEMO_JWT_SECRET=demo-only-change-me-3333333333333333333333333333333333333333333333

# --- Observability profile only ------------------------------------------------------------------
# Token Prometheus presents as X-Metrics-Token; also configured on every service's /metrics.
#   openssl rand -hex 24
METRICS_TOKEN=demo-only-change-me-4444444444444444444444444444
GRAFANA_ADMIN_PASSWORD=demo-only-change-me-5555555555555555

# --- Evidence ledger signing key -----------------------------------------------------------------
# There is no variable for it. On first start the one-shot `ledger-keygen` job runs
# `python -m evidence_ledger.keygen` into the `ledger-keys` volume (Ed25519, PEM, mode 0600,
# refuses to overwrite) and the ledger loads it via LEDGER_SIGNING_KEY_FILE. To keep the key across
# `down -v`, copy it out of the volume first. Rotated-out public keys: LEDGER_RETIRED_PUBKEYS.
LEDGER_RETIRED_PUBKEYS=

# --- Optional tuning -----------------------------------------------------------------------------
SIM_SEED=1
SIM_SPEED=60
SIM_CITIZENS=2000
HOLD_DEADLINE_S=120
LOG_LEVEL=INFO
