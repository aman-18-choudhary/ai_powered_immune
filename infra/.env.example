# ScamShield Immune: compose environment.  Copy to infra/.env and edit.
#
#   cp infra/.env.example infra/.env
#
# EVERY VALUE BELOW IS A DEMO-ONLY PLACEHOLDER. It is public (it is in the repository), so it must
# never be used anywhere reachable by anyone but you. Replace each one before running; generation
# commands are given per variable. `docker compose` refuses to start while a required value is empty.
#
# Nothing here is a real credential, and the stack only handles simulator-generated data.

# --- Gateway (services/gateway) ---------------------------------------------------------------
# HS256 signing secret for the staff/citizen JWTs. At least 32 bytes (the gateway refuses shorter).
#   openssl rand -hex 32
GATEWAY_JWT_SECRET=demo-only-change-me-0000000000000000000000000000000000000000000000
# Demo accounts (one per role: officer, analyst, citizen, admin; username == role). The gateway has
# no user database, so GATEWAY_DEMO_USERS=1 is how you can log in at all. Demo only.
#   openssl rand -hex 16
GATEWAY_DEMO_PASSWORD=demo-only-change-me-0000000000000000

# --- Antibody hub <-> bank services ---------------------------------------------------------------
# Shared secret the txn-guards present (X-Gateway-Secret) when they call the hub.
#   openssl rand -hex 32
HUB_GATEWAY_SECRET=demo-only-change-me-1111111111111111111111111111111111111111111111

# --- Postgres (hub, ledger, graph-twin, geo-intel and citizen-shield databases) ---------------------------------------------
# Use hex only (it is embedded in a URL).   openssl rand -hex 16
POSTGRES_PASSWORD=demo-only-change-me-2222222222222222

# --- Citizen shield: key for the keyed hash of reported message hashes (>= 16 bytes) -------------
#   openssl rand -hex 32
CITIZEN_REPORT_KEY=demo-only-change-me-6666666666666666666666666666666666666666666666

# --- Complaints service (services/complaints) ------------------------------------------------------
# Identity provider: Clerk (RS256 session JWTs verified against the instance JWKS). The values
# below are PLACEHOLDERS: no Clerk instance exists for this repository, and live verification has
# not been exercised. With these placeholders the service starts but sign-in answers 503.
#   Dashboard -> API keys / Domains gives the instance domain; the JWKS lives at
#   https://<instance domain>/.well-known/jwks.json and the issuer is https://<instance domain>.
# COMPLAINTS_AUTH_MODE: clerk (Clerk session tokens only), or, for local development only,
# local / demo (HS256 demo tokens + an email one-time-code sign-in whose code is printed in the
# server terminal; anyone who can read that terminal can sign in as any address).
# The demo server (port 8080) defaults to local unless CLERK_ISSUER and CLERK_JWKS_URL are set.
COMPLAINTS_AUTH_MODE=clerk
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Comma separated origins allowed as the token's `azp` claim (the console's origin). Empty = not checked.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Optional token audience, and the optional Backend API lookup (OFF; needs CLERK_SECRET_KEY; not exercised).
CLERK_AUDIENCE=
CLERK_BACKEND_LOOKUP=0
CLERK_SECRET_KEY=
# Publishable (browser) key, returned by GET /auth/config so the console can load Clerk. Must start
# with pk_test_ or pk_live_ (a secret sk_ key is refused). Placeholder: leave empty without Clerk.
CLERK_PUBLISHABLE_KEY=
# The console reads its own copy at build time (web-console): VITE_CLERK_PUBLISHABLE_KEY=<same pk_ value>
# The Clerk JWT template must add the claims: email, email_verified, name (see services/complaints/README.md).
# Investigator sign-in is limited to these VERIFIED emails (comma separated, case-insensitive).
# Example value for the project owner's own account:
INVESTIGATOR_ALLOWLIST=amanduddy151203@gmail.com
# Verified emails that become ADMIN on first sign-in (comma separated). Empty = nobody is bootstrapped.
ADMIN_BOOTSTRAP_EMAILS=
# Explicit browser origins allowed by CORS (never "*").
COMPLAINTS_CORS_ORIGINS=http://localhost:5173
# Only when COMPLAINTS_AUTH_MODE=demo or local (local demos; at least 32 bytes). Leave empty otherwise.
# (The demo server ignores it and signs with DEMO_JWT_SECRET.)
#   openssl rand -hex 32
COMPLAINTS_DEMO_JWT_SECRET=

# --- Demo server (single-process demo + console, port 8080) --------------------------------------
# JWT secret for the demo server's own /api/auth/demo-login tokens. >= 32 bytes.
#   openssl rand -hex 32
DEMO_JWT_SECRET=demo-only-change-me-3333333333333333333333333333333333333333333333
# The demo server mounts the complaints API at /api/complaints. Its SQLite file and evidence files
# live under COMPLAINTS_DATA_DIR (default ./.data/complaints, gitignored) unless
# COMPLAINTS_DATABASE_URL / COMPLAINTS_EVIDENCE_DIR are set. It reads INVESTIGATOR_ALLOWLIST and
# ADMIN_BOOTSTRAP_EMAILS above.
COMPLAINTS_DATA_DIR=
# Fraud DNA (similar complaints): needs the optional 'dna' extra and the model in the local
# Hugging Face cache (never downloaded at runtime). The index directory defaults to
# <COMPLAINTS_DATA_DIR>/dna under the demo server, memory otherwise.
COMPLAINTS_DNA_ENABLED=1
COMPLAINTS_DNA_DIR=

# --- Observability profile only ------------------------------------------------------------------
# Token Prometheus presents as X-Metrics-Token; also configured on every service's /metrics.
#   openssl rand -hex 24
METRICS_TOKEN=demo-only-change-me-4444444444444444444444444444
GRAFANA_ADMIN_PASSWORD=demo-only-change-me-5555555555555555

# --- Evidence ledger signing key -----------------------------------------------------------------
# There is no variable for it. On first start the one-shot `ledger-keygen` job runs
# `python -m evidence_ledger.keygen` into the `ledger-keys` volume (Ed25519, PEM, mode 0600,
# refuses to overwrite) and the ledger loads it via LEDGER_SIGNING_KEY_FILE. To keep the key across
# `down -v`, copy it out of the volume first. Rotated-out public keys: LEDGER_RETIRED_PUBKEYS.
LEDGER_RETIRED_PUBKEYS=

# --- Optional tuning -----------------------------------------------------------------------------
SIM_SEED=1
SIM_SPEED=60
SIM_CITIZENS=2000
HOLD_DEADLINE_S=120
LOG_LEVEL=INFO
